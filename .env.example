# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your_secret_key_here_min_32_characters_for_production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For local development: can leave blank to use mongodb-memory-server
# For production: Use MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/quiz-arena

# ============================================================================
# FRONTEND CONFIGURATION (CORS)
# ============================================================================
# For development: http://localhost:5000 or http://localhost:3000
# For production: https://your-vercel-domain.vercel.app
# Supports multiple origins (comma-separated): https://app1.vercel.app,https://app2.vercel.app
CLIENT_ORIGIN=http://localhost:5000

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES (for Vercel)
# ============================================================================
# These should be set in Vercel Dashboard under Environment Variables
# VITE_API_URL=https://your-backend-api.onrender.com/api
# VITE_SOCKET_URL=https://your-backend-api.onrender.com

# ============================================================================
# MONITORING & DEBUGGING
# ============================================================================
# Set to 'true' in development for detailed logs
# Set to 'false' in production for better performance
ENABLE_MONITORING=true
DEBUG_API=true
DEBUG_MONITORING=false
SIMULATE_SLOW_DB=false
