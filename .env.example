# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_secret_key_here

# Database Configuration
# Local development can leave this blank to use mongodb-memory-server
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/quiz-arena

# Monitoring & Debugging
ENABLE_MONITORING=true
DEBUG_API=true
DEBUG_MONITORING=false
SIMULATE_SLOW_DB=false

# Client Configuration (Optional for monolith deployment)
# VITE_API_URL=https://your-api.onrender.com/api
# VITE_SOCKET_URL=https://your-api.onrender.com
# CLIENT_ORIGIN=http://localhost:5000
